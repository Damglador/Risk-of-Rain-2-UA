#: .strings.FAITHFUL_COPPER_GEAR_NAME
msgctxt ".strings.FAITHFUL_COPPER_GEAR_NAME"
msgid "Copper Gear"
msgstr ""

#: .strings.FAITHFUL_COPPER_GEAR_PICKUP
msgid "Increase attack speed while within the Teleporter zone."
msgstr ""

#: .strings.FAITHFUL_COPPER_GEAR_PICKUP_QUALITY
msgid ""
"[PREFIX]\n"
"<sprite name=\"Quality\"> Killing an enemy while within the Teleporter zone "
"gives you a burst of attack speed."
msgstr ""

#: .strings.FAITHFUL_COPPER_GEAR_DESC
msgid ""
"Increase <style=cIsDamage>attack speed</style> by "
"<style=cIsDamage>[ATTACK_SPEED]%</style> "
"<style=cStack>(+[ATTACK_SPEED_STACKING]% per stack)</style> while inside the "
"Teleporter zone."
msgstr ""

#: .strings.FAITHFUL_COPPER_GEAR_DESC_QUALITY
msgid ""
"[PREFIX]\n"
"Each enemy killed while inside the Teleporter zone increases "
"<style=cIsDamage>attack speed</style> by <sprite name=\"Quality\"> "
"<style=cIsDamage>[ATTACK_SPEED]%</style> for <sprite name=\"Quality\"> "
"<style=cIsDamage>[DURATION]</style> <style=cStack>(+[DURATION_STACKING] per "
"stack)</style> seconds."
msgstr ""

#: .strings.FAITHFUL_COPPER_GEAR_LORE
msgid ""
"<style=cMono>\r//--AUTO-TRANSCRIPTION FROM UES [Redacted] --//</style>\r\n"
"\r\n"
"\"Hey, you know those clockmakers we met when we went on that trip to Earth?"
"\"\n"
"\n"
"\"Yeah, I remember. Why are you bringing them up now?\"\n"
"\n"
"\"A couple o' them told me that they were always in the zone when wearing "
"one of these gears 'round their wrist. Said it helped 'em work way faster.\""
"\n"
"\n"
"\"I see but… what does that have to do with the mountain of lemurian corpses "
"behind you?\"\n"
"\n"
"\"Well, uh… I can tell you that it works.\""
msgstr ""

