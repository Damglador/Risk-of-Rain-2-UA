"<style=cIsUtility>Teleport</style> toward a targeted enemy, dealing "
"<style=cIsDamage>340% damage</style> on contact and launching yourself into "
"the air."
msgstr ""

#: .strings.FAITHFUL_SURVIVOR_TECHNICIAN_SPECIAL_CONDUIT_NAME
