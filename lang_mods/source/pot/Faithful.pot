"Tether an enemy with a <style=cIsDamage>piercing</style> electrical arc, "
"dealing <style=cIsDamage>400% per second</style> and "
"<style=cIsUtility>slowing</style> them. The arc can be "
"<style=cIsUtility>transferred between enemies</style>."
msgstr ""

#: .strings.FAITHFUL_SURVIVOR_TECHNICIAN_SECONDARY_POWERVOLT_NAME
msgid "Powervolt"
msgstr ""

#: .strings.FAITHFUL_SURVIVOR_TECHNICIAN_SECONDARY_POWERVOLT_DESCRIPTION
