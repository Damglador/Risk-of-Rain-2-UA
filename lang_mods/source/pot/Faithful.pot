"<style=cIsDamage>420% damage</style>. Creates a blast of electricity instead "
"while tethered to an enemy."
msgstr ""

#: .strings.FAITHFUL_SURVIVOR_TECHNICIAN_UTILITY_CHARGE_FLOW_NAME
msgid "Charge Flow"
msgstr ""

